# Environment
.env

# Python
__pycache__/
*.pyc
*.pyo
venv/
*.egg-info/

# Logs
*.log

# System
.DS_Store
Thumbs.db

# Config — ignore all mounted user-home junk, track only vault data
config/.XDG/
config/.bashrc
config/.cache/
config/.config/
config/.local/
config/.obsidian-cli.sock
config/.pki/
config/ssl/
config/.webclipper/prefs.json

# Obsidian vault auto-generated files
config/**/.obsidian/
config/**/.trash/

# Uploaded images (runtime data)
webclipper/static/uploads/*.png
